# Python codebase default gitignore (github template)

# hail logs
hail*.log

# scratch files
/scratch/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# local irrelevant files
.idea
.DS_Store

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

#nextflow
.nextflow/
.nextflow.log*
nextflow/*test/
nextflow/processed_annotations/
work/
preflight/.nextflow/
preflight/.nextflow.log*
preflight/work/
preflight/results/
nextflow_test_output/
nextflow_test_output_apptainer/
.nextflow-apptainer/

# mkdocs
site/

# Added by code-review-graph
.code-review-graph/
CLAUDE.md

# local Codex / shell state
.cdx
.cmd
.codex

# local office lock files
*.~lock*
nextflow/inputs/.~lock*

# generated resources and outputs
large_files/*.tsv.gz
large_files/*.txt.gz
large_files/*.txt
large_files/*.txt.zip
large_files/*.json
large_files/*.obo
large_files/*.db
large_files/*.gz
large_files/*.zip
large_files/ref.fa
large_files/gnomad_4.1_region_merged_GRCh38_whole_genome
processed_annotations/

# apptainer build artifacts and staged env payloads
apptainer/assets/
apptainer/build/
*.sif

# local full-workflow example and generated bundles
trio_runs/
local_examples/
