params {
    department = 'DEPT'
    samplelist_xlsx = null
    sample_manifest = null
    pedigree = null
    mapping_roots = null
    runtime_bin_dir = null
    tool_bin_dir = null
    family_merge_enabled = false
    publish_family_vcfs = false
    flush_published_family_vcfs = false
    common_dbsnp_enabled = false
    common_dbsnp_vcf = null
    spliceai_enabled = false
    spliceai_vcf = null
    talos_input_enabled = true
    talos_cohort = null
    talos_variant_type = 'vcf'
    talos_config = null
    talos_history = "${projectDir}/../nextflow/assets/NO_HISTORY"
    talos_ext_ids = "${projectDir}/../nextflow/assets/NO_FILE"
    talos_seqr_map = "${projectDir}/../nextflow/assets/NO_SEQR_FILE"
    talos_mito = "${projectDir}/../nextflow/assets/NO_MITO"
}

process {
    executor = 'local'
    cpus = 2
    memory = 8.GB
    errorStrategy = 'terminate'
    beforeScript = (params.runtime_bin_dir ?: params.tool_bin_dir) ? "export PATH=\"${params.runtime_bin_dir ?: params.tool_bin_dir}:\$PATH\"" : ''
}
