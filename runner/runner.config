# The bundled runner opens this minimal raw fixture by default.
PREFLIGHT_DEFAULT_PROJECT_DIR=/faststorage/project/reanalyses_auh/v2/talos_aargus/runner/synthetic_one_proband_two_variants
PREFLIGHT_SAMPLELIST_FILENAME=samplelist.xlsx
PREFLIGHT_SOURCE_VCF_FOLDERS=
PREFLIGHT_DEPARTMENT=DEPT

PREFLIGHT_INPUTS_DIR=inputs
PREFLIGHT_OUTPUTS_DIR=outputs
PREFLIGHT_WORK_DIR=work
PREFLIGHT_LOG_DIR=logs
PREFLIGHT_NEXTFLOW_LOG=logs/.nextflow.log
PREFLIGHT_SYMLINK_DIR=VCF_symlinks
PREFLIGHT_JOB_NAME=talos_preflight
PREFLIGHT_TALOS_COHORT=DEPT
PREFLIGHT_TALOS_CONFIG=config/config.toml
PREFLIGHT_SPLICEAI_ENABLED=false
PREFLIGHT_SPLICEAI_VCF=/faststorage/project/reanalyses_auh/resources/spliceai_scores_KGA_AUH_GRCh_38_Homo_sapiens_converted.vcf.gz
PREFLIGHT_FAMILY_MERGE_ENABLED=false
PREFLIGHT_CPUS=2
PREFLIGHT_MEM=8G
PREFLIGHT_TIME=01:00:00
PREFLIGHT_RESUME=true

PREPARATION_WORK_DIR=/faststorage/project/reanalyses_auh/v2/talos_aargus
PREPARATION_PROCESSED_ANNOTATIONS=processed_annotations
PREPARATION_LARGE_FILES=large_files
PREPARATION_ENV_PREFIX=/faststorage/project/reanalyses_auh/env/talos2_env

TALOS_TOOL_DIR=/faststorage/project/reanalyses_auh/v2/talos_aargus
TALOS_INPUT_TSV=outputs/talos_input.tsv
TALOS_OUTPUT_DIR=cohort_outputs
TALOS_PROCESSED_ANNOTATIONS=/faststorage/project/reanalyses_auh/v2/talos_aargus/processed_annotations
TALOS_NEXTFLOW_CONFIG=/faststorage/project/reanalyses_auh/v2/talos_aargus/runner/talos_local.config
TALOS_CONDA_ENV=/faststorage/project/reanalyses_auh/env/talos2_env
TALOS_SPLICEAI_ENABLED=true
TALOS_SPLICEAI_VCF=/faststorage/project/reanalyses_auh/resources/spliceai_scores_KGA_AUH_GRCh_38_Homo_sapiens_converted.vcf.gz
TALOS_LOG_DIR=logs
TALOS_JOB_NAME=talos_full
TALOS_CPUS=2
TALOS_MEM=16G
TALOS_TIME=02:00:00
TALOS_RESUME=true

RESOURCE_SCRIPT_CANDIDATES=/faststorage/project/reanalyses_auh/v2/talos_aargus/large_files/download_resources_slurm.sh
