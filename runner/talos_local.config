// Native AUH runtime configuration for runner projects.
params.run_dir = System.getenv('RUN_DIR') ?: System.getProperty('user.dir')

params {
    input_tsv = "${params.run_dir}/outputs/talos_input.tsv"
    outdir = "${params.run_dir}/cohort_outputs"
    processed_annotations = System.getenv('PROCESSED_ANNOTATIONS_DIR') ?: "${projectDir}/processed_annotations"
    large_files = "${projectDir}/large_files"

    ref_genome = "${params.large_files}/ref.fa"
    mane = "${params.large_files}/MANE.GRCh38.v1.5.summary.txt.gz"
    mane_json = "${params.processed_annotations}/mane.json"
    ensembl_gff = "${params.large_files}/Homo_sapiens.GRCh38.116.MTtoM.gff3.gz"
    ensembl_bed = "${params.processed_annotations}/GRCh38.bed"
    ensembl_merged_bed = "${params.processed_annotations}/GRCh38_merged.bed"
    ensembl_symbol_lookup = "${params.processed_annotations}/GRCh38_symbol_to_ensg.json"
    alphamissense_zip = "${params.processed_annotations}/alphamissense.zip"
    mitimpact_zip = "${params.processed_annotations}/mitimpact.zip"
    mitotip_zip = "${params.processed_annotations}/mitotip.zip"
    napogee_zip = "${params.processed_annotations}/napogee.zip"
    gnomad_zip = "${params.large_files}/gnomad_4.1_region_merged_GRCh38_whole_genome"
    hpo = "${params.large_files}/hp.obo"
    gen2phen = "${params.large_files}/genes_to_phenotype.txt"
    phenio_db = "${params.large_files}/phenio.db"

    spliceai_enabled = (System.getenv('SPLICEAI_ENABLED') ?: 'true').toBoolean()
    spliceai_vcf = System.getenv('SPLICEAI_VCF') ?: "/faststorage/project/reanalyses_auh/resources/spliceai_scores_KGA_AUH_GRCh_38_Homo_sapiens_converted.vcf.gz"
}

outputDir = "${params.run_dir}/cohort_outputs"
workDir = "${params.run_dir}/work"

docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
process.container = null

timeline {
    enabled = true
    file = "${params.run_dir}/logs/talos_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.run_dir}/logs/talos_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.run_dir}/logs/talos_trace.txt"
    overwrite = true
}
